{
  "name": "rrjs-flip",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "One React app, two render targets. The source is ordinary React; only the entry file and the build config differ.",
  "scripts": {
    "dev:react": "vite --config vite.config.react.ts --port 5210 --strictPort",
    "dev:rrjs": "vite --config vite.config.rrjs.ts --port 5211 --strictPort",
    "build:react": "vite build --config vite.config.react.ts",
    "build:rrjs": "vite build --config vite.config.rrjs.ts",
    "typecheck:react": "tsc -p tsconfig.react.json --noEmit",
    "typecheck:rrjs": "tsc -p tsconfig.rrjs.json --noEmit",
    "dev:run-once": "vite --config vite.config.run-once.ts",
    "build:run-once": "vite build --config vite.config.run-once.ts",
    "build:run-once-reference": "vite build --config vite.config.run-once-reference.ts",
    "build:phase6": "vite build --config vite.config.phase6.ts",
    "build:phase7": "vite build --config vite.config.phase7.ts",
    "build:phase7:react": "vite build --config vite.config.phase7.react.ts"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@rrjs/signals": "file:../../packages/signals",
    "@rrjs/renderer": "file:../../packages/renderer",
    "@rrjs/react-compat": "file:../../packages/react-compat"
  },
  "devDependencies": {
    "@rrjs/babel-plugin": "file:../../packages/babel-plugin",
    "@babel/core": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
