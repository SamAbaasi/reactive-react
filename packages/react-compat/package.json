{
  "name": "@rrjs/react-compat",
  "version": "0.2.3",
  "description": "React hooks API on top of signals: useState, useEffect, useReducer, useContext, and more",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@rrjs/signals": "^0.2.3"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "author": "Saman Abaasi <samyar1992@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamAbaasi/reactive-react.git",
    "directory": "packages/react-compat"
  },
  "keywords": [
    "react",
    "hooks",
    "compatibility",
    "signals",
    "useState",
    "useEffect"
  ]
}
