{
  "name": "@rrjs/renderer",
  "version": "0.2.1",
  "description": "Signal-driven DOM renderer with keyed list reconciliation. No VDOM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@rrjs/signals": "^0.2.1",
    "@rrjs/react-compat": "^0.2.1"
  },
  "devDependencies": {
    "vitest": "^1.0.0",
    "typescript": "^5.0.0",
    "jsdom": "^24.0.0",
    "@types/node": "^20.0.0"
  },
  "license": "MIT",
  "author": "Saman Abaasi <samyar1992@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamAbaasi/reactive-react.git",
    "directory": "packages/renderer"
  },
  "keywords": [
    "renderer",
    "dom",
    "signals",
    "fine-grained",
    "no-vdom"
  ]
}
